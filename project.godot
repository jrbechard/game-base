; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Game_Base"
run/main_scene="res://Scenes/Global/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[autoload]

Global_Manager_Events="*res://Scripts/Global/global_manager_events.gd"
Global_Manager_GameData="*res://Scripts/Global/global_manager_gamedata.gd"
Global_Manager_Progress="*res://Scripts/Global/global_manager_progress.gd"
Global_Manager_Save="*res://Scripts/Global/global_manager_save.gd"
Global_Manager_Input="*res://Scripts/Global/global_manager_input.gd"
Global_Manager_Rumble="*res://Scripts/Global/global_manager_rumble.gd"
Global_Manager_SFX="*res://Scripts/Global/global_manager_sfx.gd"
Global_Manager_Music="*res://Scripts/Global/global_manager_music.gd"
Global_Manager_Settings="*res://Scripts/Global/global_manager_settings.gd"
Global_Manager_Scenes="*res://Scripts/Global/global_manager_scenes.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"

[editor_plugins]

enabled=PackedStringArray("res://addons/gut/plugin.cfg")

[gui]

theme/custom="res://Assets/Theming/theme_main.tres"

[internationalization]

locale/translations=PackedStringArray("res://Data/Translations/items_translations.en.translation", "res://Data/Translations/items_translations.fr.translation", "res://Data/Translations/ui_translations.en.translation", "res://Data/Translations/ui_translations.fr.translation")
